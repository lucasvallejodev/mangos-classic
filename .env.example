# =============================================================================
# CMaNGOS Classic - Docker settings
# Copy to .env and edit:  cp .env.example .env
#
# Passwords: avoid ; " ' $ ` and spaces (they end up in connection strings and shell config).
# =============================================================================

# ----- General ---------------------------------------------------------------
TZ=UTC
# Owner of ./config and ./logs on the host (`id -u` / `id -g`)
PUID=1000
PGID=1000

# ----- Build -----------------------------------------------------------------
# Parallel compile jobs (0 = all cores). Use 2 on a 4GB Raspberry Pi.
BUILD_JOBS=0

# ----- Database --------------------------------------------------------------
DB_ROOT_PASSWORD=change-me-root
DB_USER=mangos
DB_PASSWORD=change-me
WORLD_DB=classicmangos
CHAR_DB=classiccharacters
REALM_DB=classicrealmd
LOGS_DB=classiclogs
# MariaDB InnoDB cache. 512M is fine for a Pi 5 8GB, use 256M on 4GB.
DB_BUFFER_POOL_SIZE=512M
# 1 = apply pending core SQL updates on every start
DB_AUTO_UPDATE=1
# Install localized texts
DB_LOCALES=YES

# ----- Realm -----------------------------------------------------------------
REALM_ID=1
REALM_NAME=CMaNGOS Classic
# IP/hostname clients use to reach the world server: the Pi's LAN IP (e.g. 192.168.1.50)
REALM_ADDRESS=127.0.0.1
# Host ports: 3724 = login (realmd), 8085 = world (mangosd)
REALMD_PORT=3724
REALM_PORT=8085
# 0 = Normal, 1 = PvP, 6 = RP, 8 = RP-PvP
REALM_TYPE=1
# 1 = Development, 2 = United States, 8 = English (EU)... see mangosd.conf RealmZone
REALM_TIMEZONE=1
# Minimum account security level allowed to log in (0 = everyone)
REALM_SECURITY_LEVEL=0
MOTD=Welcome to CMaNGOS Classic
PLAYER_LIMIT=100

# ----- Server ----------------------------------------------------------------
# Server console on the container TTY (docker attach cmangos-mangosd)
CONSOLE_ENABLED=1
LOG_LEVEL=1
# Movement maps, needed for good bot/creature pathing
MMAPS_ENABLED=1

# ----- Characters ------------------------------------------------------------
MAX_PLAYER_LEVEL=60
START_PLAYER_LEVEL=1
# In copper
START_PLAYER_MONEY=0
# 1 = allow Horde and Alliance characters on the same account
ALLOW_TWO_SIDE_ACCOUNTS=0
# Characters per account on this realm (1-10, client limit)
CHARACTERS_PER_REALM=10
# Primary professions a character can learn (0-10). Single player: 10 = learn them all.
MAX_PRIMARY_PROFESSIONS=2
# Intro cinematic: 0 = every new character, 1 = first character of each race, 2 = never
SKIP_CINEMATICS=0
# 1 = every character starts with all flight paths (both factions)
ALL_FLIGHT_PATHS=0
# 1 = weapon and defense skills are always at max for your level (no weapon skill grinding)
ALWAYS_MAX_WEAPON_SKILL=0
# Level at which resurrection sickness starts. Set to MAX_PLAYER_LEVEL + 1 to disable it.
DEATH_SICKNESS_LEVEL=11
# Seconds before mail with items arrives. Single player: 0 = instant mail to your alts.
MAIL_DELIVERY_DELAY=3600
# Character autosave interval in ms (default 15 min). 300000 (5 min) loses less on a power cut.
PLAYER_SAVE_INTERVAL=900000

# ----- Cross-faction ---------------------------------------------------------
# 1 = Horde and Alliance can chat, group, guild, trade, mail and share the auction house.
# Useful for grouping with your alts/bots of the other faction.
ALLOW_TWO_SIDE_INTERACTION=0

# ----- Instances -------------------------------------------------------------
# 1 = ignore the minimum level to enter dungeons/raids
INSTANCE_IGNORE_LEVEL=0
# 1 = enter raids without being in a raid group (solo or small group)
INSTANCE_IGNORE_RAID=0
# 1 = complete normal quests while in a raid group
QUESTS_IGNORE_RAID=0
# Multiplier for days between raid resets (0.5 = twice as often)
RATE_INSTANCE_RESET_TIME=1

# ----- Difficulty ------------------------------------------------------------
# Creature health and damage multipliers. Below 1 makes content easier to solo
# (e.g. 0.5 elite HP/damage for dungeons with only a few bots).
# "Normal" covers normal and rare mobs, "elite" covers elites, rare elites and world bosses.
RATE_CREATURE_NORMAL_HP=1
RATE_CREATURE_NORMAL_DAMAGE=1
RATE_CREATURE_ELITE_HP=1
RATE_CREATURE_ELITE_DAMAGE=1

# ----- Rates -----------------------------------------------------------------
RATE_XP_KILL=1
RATE_XP_QUEST=1
RATE_XP_EXPLORE=1
# Rested XP gain (in game and offline)
RATE_REST=1
RATE_DROP_MONEY=1
# Poor..Epic item drop rates
RATE_DROP_ITEMS=1
RATE_REPUTATION=1
RATE_HONOR=1
# Crafting / gathering / weapon / defense skill-ups per success
RATE_SKILL_GAIN=1
# Talent points per level
RATE_TALENT=1
# Hunter pet XP from kills
RATE_PET_XP=1

# ----- Anticheat -------------------------------------------------------------
ANTICHEAT_ENABLED=0
# Warden client scanning, off for a local server
WARDEN_ENABLED=0

# ----- Auction House Bot -----------------------------------------------------
# Percent chance per cycle to post / buy items (0 disables that side)
AHBOT_CHANCE_SELL=10
AHBOT_CHANCE_BUY=10
AHBOT_MAX_REQUIRED_LEVEL=60

# ----- Playerbots ------------------------------------------------------------
PLAYERBOTS_ENABLED=1
# Create random bot accounts/characters on startup (first start takes a while)
PLAYERBOTS_AUTO_CREATE_ACCOUNTS=1
# Number of bot accounts (up to 9 characters each)
PLAYERBOTS_ACCOUNT_COUNT=50
# Random bots logged into the world. 0 = none; raise to e.g. 50-200 to populate the world.
PLAYERBOTS_MIN_RANDOM_BOTS=0
PLAYERBOTS_MAX_RANDOM_BOTS=0
PLAYERBOTS_MIN_LEVEL=1
PLAYERBOTS_MAX_LEVEL=60
# Random bots queue for dungeons (LFG) and battlegrounds, so you can find groups
PLAYERBOTS_JOIN_LFG=1
PLAYERBOTS_JOIN_BG=1
# 1 = log in all your other characters as bots when you log in
PLAYERBOTS_ALTS_AUTOLOGIN=0
# 1 = your bots learn trainer / class quest spells automatically when they level
PLAYERBOTS_AUTO_LEARN_TRAINER_SPELLS=0
PLAYERBOTS_AUTO_LEARN_QUEST_SPELLS=0
# 1 = bots equip upgrades they loot or get from quests
PLAYERBOTS_AUTO_EQUIP_UPGRADES=1
# 1 = bots in your group complete quests when you hand them in
PLAYERBOTS_SYNC_QUESTS=1

# ----- Any other setting -----------------------------------------------------
# Any key of the config files can be set with <Prefix><Key>, dots replaced by underscores.
# Names are case-sensitive and must match the key as written in the .conf file.
#   mangosd.conf / ahbot.conf -> Mangosd_     e.g. Mangosd_Rate_Mining_Amount=2
#   realmd.conf               -> Realmd_      e.g. Realmd_WrongPass_MaxCount=5
#   aiplayerbot.conf          -> PlayerBots_  e.g. PlayerBots_AiPlayerbot_RandomBotGuildCount=5
#   anticheat.conf            -> Anticheat_   e.g. Anticheat_Movement_SpeedHack_Enable=0
# Values from this file win over the files in ./config.
